{
  "manifest_version": 3,
  "name": "LeadFlow AI - Social Lead Outreach",
  "version": "1.0.0",
  "description": "AI-powered lead generation on Facebook, Reddit, Instagram, X and more",
  "permissions": ["cookies", "activeTab", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.reddit.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.youtube.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.linkedin.com/*",
    "https://leadflow-ai-z2rf.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.reddit.com/*"],
      "js": ["reddit.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
